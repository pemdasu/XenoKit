<UserControl x:Class="XenoKit.Views.BpeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:XenoKit.ViewModel.BPE"
             xmlns:lbUtils="clr-namespace:LB_Common.Utils;assembly=LB_Common"
             x:Name="View" Foreground="{DynamicResource MahApps.Brushes.Text}" Background="{DynamicResource MahApps.Brushes.Control.Background}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BpeTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Circle}">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="RailLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
            </Style>
            <!-- Layer type menu items, shared by the New button and the list context menu. -->
            <Style x:Key="AddTypeItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                <Setter Property="Header" Value="{Binding Value}"/>
                <Setter Property="Command" Value="{Binding DataContext.AddKeyframeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Setter Property="CommandParameter" Value="{Binding Key}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="310*" MinHeight="180"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="200*" MinHeight="160"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.4*" MinWidth="75" MaxWidth="280"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="1.2*" MinWidth="350"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Height="50" Margin="10,9,0,0" VerticalAlignment="Top">
                <StackPanel Margin="7,0,0,0" VerticalAlignment="Center" ToolTip="Add Entry">
                    <Button Style="{StaticResource RailButton}" Command="{Binding AddEntryCommand, ElementName=View}">
                        <iconPacks:PackIconMaterialLight Kind="Plus"/>
                    </Button>
                    <TextBlock Text="Add" Style="{StaticResource RailLabel}"/>
                </StackPanel>
                <StackPanel Margin="7,0,0,0" VerticalAlignment="Center" ToolTip="Remove Entry">
                    <Button Style="{StaticResource RailButton}" Command="{Binding RemoveEntryCommand, ElementName=View}">
                        <iconPacks:PackIconMaterialLight Kind="Delete"/>
                    </Button>
                    <TextBlock Text="Remove" Style="{StaticResource RailLabel}"/>
                </StackPanel>
            </StackPanel>

            <DataGrid x:Name="entries" Grid.Row="1" AutomationProperties.Name="Post effect entries" Tag="{Binding ElementName=View}" PreviewMouseLeftButtonDown="Entries_PreviewMouseLeftButtonDown">
                <DataGrid.InputBindings>
                    <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateEntryCommand, ElementName=View}"/>
                    <KeyBinding Key="Delete" Command="{Binding RemoveEntryCommand, ElementName=View}"/>
                </DataGrid.InputBindings>
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Add" Command="{Binding AddEntryCommand}"/>
                        <Separator/>
                        <MenuItem Header="Duplicate" Command="{Binding DuplicateEntryCommand}" InputGestureText="Ctrl+D"/>
                        <MenuItem Header="Delete" Command="{Binding RemoveEntryCommand}" InputGestureText="Delete"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Index}" Width="*" SortMemberPath="SortID"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding I_04}" Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Stretch" Background="{DynamicResource MahApps.Brushes.Accent}"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Height="50" Margin="10,9,0,0" VerticalAlignment="Top">
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Add a keyframe. If the entry has no layer of that type, this also adds the layer.">
                    <Button Style="{StaticResource RailButton}" Tag="{Binding ElementName=View}" lbUtils:ContextMenuLeftClickBehavior.IsLeftClickEnabled="True">
                        <iconPacks:PackIconMaterialLight Kind="Plus"/>
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                         ItemsSource="{x:Static vm:BpeKeyframeRow.TypeNames}" ItemContainerStyle="{StaticResource AddTypeItem}"/>
                        </Button.ContextMenu>
                    </Button>
                    <TextBlock Text="New" Style="{StaticResource RailLabel}"/>
                </StackPanel>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Remove Keyframe">
                    <Button Style="{StaticResource RailButton}" Command="{Binding RemoveKeyframeCommand, ElementName=View}">
                        <iconPacks:PackIconMaterialLight Kind="Delete"/>
                    </Button>
                    <TextBlock Text="Remove" Style="{StaticResource RailLabel}"/>
                </StackPanel>
            </StackPanel>

            <DataGrid x:Name="rows" Grid.Column="2" Grid.Row="1" AutomationProperties.Name="Post effect keyframes" Tag="{Binding ElementName=View}"
                      ItemsSource="{Binding Rows, ElementName=View}" SelectedItem="{Binding SelectedRow, ElementName=View}" SelectionMode="Extended">
                <DataGrid.InputBindings>
                    <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateKeyframeCommand, ElementName=View}"/>
                    <KeyBinding Key="Delete" Command="{Binding RemoveKeyframeCommand, ElementName=View}"/>
                </DataGrid.InputBindings>
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Add" ItemsSource="{x:Static vm:BpeKeyframeRow.TypeNames}" ItemContainerStyle="{StaticResource AddTypeItem}"/>
                        <Separator/>
                        <MenuItem Header="Duplicate" Command="{Binding DuplicateKeyframeCommand}" InputGestureText="Ctrl+D"/>
                        <MenuItem Header="Delete" Command="{Binding RemoveKeyframeCommand}" InputGestureText="Delete"/>
                        <Separator/>
                        <MenuItem Header="Hue Adjustment" Command="{Binding HueAdjustCommand}" ToolTip="Shift the hue, saturation and lightness of the selected keyframes that have a color."/>
                        <MenuItem Header="Hue Set" Command="{Binding HueSetCommand}" ToolTip="Set the hue of the selected keyframes that have a color."/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Start" Binding="{Binding Start, Mode=OneWay}" Width="Auto"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration, Mode=OneWay}" Width="Auto"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="{DynamicResource MahApps.Brushes.Accent}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ContentControl Content="{Binding EntryViewModel, ElementName=View}"/>
                <ContentControl Content="{Binding SelectedRow, ElementName=View}"/>
                <Expander Header="{Binding SelectedRow.Type, ElementName=View}" IsExpanded="True" Margin="0,2,0,0"
                          Visibility="{Binding HasKeyframe, ElementName=View, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ContentControl Content="{Binding KeyframeViewModel, ElementName=View}"/>
                </Expander>
                <ContentControl Content="{Binding LayerViewModel, ElementName=View}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
