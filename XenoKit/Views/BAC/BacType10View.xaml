<UserControl x:Class="XenoKit.Views.BAC.BacType10View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:root="clr-namespace:XenoKit"
             xmlns:local="clr-namespace:XenoKit.Views.BAC"
             xmlns:bacDic="clr-namespace:Xv2CoreLib.ValuesDictionary;assembly=Xv2CoreLib"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="520">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>

        <StackPanel Margin="0, 0, 0, 0">

            <Expander Margin="0, 0, 0, 0" Header="Camera" IsExpanded="True">
                <Grid>

                    <StackPanel>
                        <WrapPanel>
                            <Grid Margin="3,3,0,0" Width="250">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="EAN File"/>
                                <ComboBox Grid.Column="1" IsEditable="False" AutomationProperties.Name="EAN File"
                                          ItemsSource="{x:Static bacDic:BAC.CameraEanType}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                          SelectedValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EanType}"
                                          controls:TextBoxHelper.Watermark="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EanTypeLabel}"
                                          ToolTip="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EanTypeLabel}"/>
                            </Grid>
                            <Grid Margin="3,3,0,0" Width="250" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.UseEanList, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Camera"/>
                                <ComboBox Grid.Column="1" IsEditable="False" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.SpecifiedEan.Animations.Binding}" DisplayMemberPath="DisplayName" SelectedValuePath="ID_UShort" SelectedValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EanIndex, UpdateSourceTrigger=Default}"/>
                            </Grid>
                            <Grid Margin="3,3,0,0" Width="250">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Camera ID"/>
                                <controls:NumericUpDown Grid.Column="1" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EanIndex, UpdateSourceTrigger=Default, Converter={StaticResource uint16Converter}}"/>
                            </Grid>
                        </WrapPanel>
                        <WrapPanel>

                            <Grid Margin="3,3,0,0" Width="250">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Start Frame"/>
                                <controls:NumericUpDown Grid.Column="1" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.StartFrame, UpdateSourceTrigger=Default, Converter={StaticResource uint16Converter}}"/>
                            </Grid>
                            <Grid Margin="3,3,0,0" Width="250">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Bone Focus"/>
                                <ComboBox Grid.Column="1" IsEditable="False" ItemsSource="{x:Static bacDic:BAC.BoneNames}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.BoneToFocusOn}"/>
                            </Grid>
                        </WrapPanel>
                        <StackPanel Margin="5" HorizontalAlignment="Left">
                            <Label Content="Camera Flags" HorizontalContentAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                            <Separator/>
                            <WrapPanel>
                                <CheckBox Width="250" Margin="5,2" Content="Play to All Players" ToolTip="Plays the camera for every player." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EnableCameraForAllPlayers, UpdateSourceTrigger=Default}"/>
                                <CheckBox Width="250" Margin="5,2" Content="Reset Camera After End" ToolTip="Returns to the normal camera when this row ends." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.ResetCameraAfterEnd, UpdateSourceTrigger=Default}"/>
                                <CheckBox Width="250" Margin="5,2" Content="Focus On Target" ToolTip="Centers the camera on the current target." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.FocusOnTarget, UpdateSourceTrigger=Default}"/>
                                <CheckBox Width="250" Margin="5,2" Content="Don't Fit to Body Size" ToolTip="Uses the camera as authored, without scaling it to fit the character." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.DontFitToBodySize, UpdateSourceTrigger=Default}"/>
                                <CheckBox Width="250" Margin="5,2" Content="Require 10-hit Combo" ToolTip="Skips this camera when the target's current combo has fewer than 10 hits." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.RequireTenHitCombo, UpdateSourceTrigger=Default}"/>
                                <CheckBox Width="250" Margin="5,2" Content="Keep While Input Held" ToolTip="Keeps built-in camera control active while an action button is held." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.KeepWhileInputHeld, UpdateSourceTrigger=Default}"/>
                                <CheckBox Width="250" Margin="5,2" Content="Lock Camera Priority" ToolTip="Blocks other BAC cameras while this EAN camera is active." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.LockCameraPriority, UpdateSourceTrigger=Default}"/>
                                <CheckBox Width="250" Margin="5,2" Content="Snap to Camera" ToolTip="Switches to this camera without a transition." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.CameraFlags_Unk10, UpdateSourceTrigger=Default}"/>
                                <CheckBox Width="250" Margin="5,2" Content="Move to Camera" ToolTip="Blends the current camera into this camera." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.CameraFlags_Unk11, UpdateSourceTrigger=Default}"/>
                                <CheckBox Width="250" Margin="5,2" Content="Keep after entry ends" ToolTip="Keeps the camera active after this row ends." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.CameraFlags_KeepAfterEnd, UpdateSourceTrigger=Default}"/>
                                <CheckBox Width="250" Margin="5,2" Content="Use Extended Camera Control" ToolTip="Uses the Type 26 row with the same Start Time as this camera." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.CameraFlags_UseType26Row, UpdateSourceTrigger=Default}"/>
                                <CheckBox Width="250" Margin="5,2" Content="Delay Blend One Frame" ToolTip="Waits one frame before blending into the new camera." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.DelayCameraBlend, UpdateSourceTrigger=Default}"/>
                                <CheckBox Width="250" Margin="5,2" Content="Reverse Camera Direction" ToolTip="Turns the camera and its aim point 180 degrees around the actor." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.ReverseCameraDirection, UpdateSourceTrigger=Default}"/>
                                <CheckBox Width="250" Margin="5,2" Content="Resume From End View" ToolTip="When an EAN camera is already active, uses its final position and aim point when the normal camera resumes." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.ResumeFromEndView, UpdateSourceTrigger=Default}"/>
                            </WrapPanel>
                            <Label Content="Unknown" HorizontalContentAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                            <Separator/>
                            <WrapPanel>
                                <CheckBox Width="250" Margin="5,2" Content="Unused (No Effect)" IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.Flag_74_4, UpdateSourceTrigger=Default}"/>
                            </WrapPanel>
                            <WrapPanel>
                                <Grid Margin="3,3,0,0" Width="250">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="I__16"/>
                                    <controls:NumericUpDown Grid.Column="1" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.I_16, UpdateSourceTrigger=Default, Converter={StaticResource uint16Converter}}"/>
                                </Grid>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Expander>
            <Expander Header="Camera Modifiers" IsExpanded="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="3,3,0,0" Width="500" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="122"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Enable"/>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EnableTransformModifers}" ToolTip="Enable the use the position, rotation and field of view modifier values."/>
                    </Grid>
                    <WrapPanel Grid.Row="1">

                        <StackPanel>
                            <Grid Margin="3,3,0,0" Width="400" IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EnableTransformModifers}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Position X"/>
                                <controls:NumericUpDown Grid.Column="1" StringFormat="0.00##" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.PositionX, UpdateSourceTrigger=Default}"/>

                                <Label Content="Blending" Grid.Column="2" Margin="10,0" ToolTip="Amount of frames of interpolation to do between base camera and Position X."/>
                                <controls:NumericUpDown Grid.Column="3" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.PositionDurationX, UpdateSourceTrigger=Default, Converter={StaticResource uint16Converter}}"/>

                            </Grid>
                            <Grid Margin="3,3,0,0" Width="400" IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EnableTransformModifers}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Position Y"/>
                                <controls:NumericUpDown Grid.Column="1" StringFormat="0.00##" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.PositionY, UpdateSourceTrigger=Default}"/>

                                <Label Content="Blending" Grid.Column="2" Margin="10,0" ToolTip="Amount of frames of interpolation to do between base camera and Position Y."/>
                                <controls:NumericUpDown Grid.Column="3" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.PositionDurationY, UpdateSourceTrigger=Default, Converter={StaticResource uint16Converter}}"/>

                            </Grid>
                            <Grid Margin="3,3,0,0" Width="400" IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EnableTransformModifers}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Position Z"/>
                                <controls:NumericUpDown Grid.Column="1" StringFormat="0.00##" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.PositionZ, UpdateSourceTrigger=Default}"/>

                                <Label Content="Blending" Grid.Column="2" Margin="10,0"  ToolTip="Amount of frames of interpolation to do between base camera and Position Z."/>
                                <controls:NumericUpDown Grid.Column="3" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.PositionDurationZ, UpdateSourceTrigger=Default, Converter={StaticResource uint16Converter}}"/>

                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <Grid Margin="3,3,0,0" Width="400" IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EnableTransformModifers}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Rotation X"/>
                                <controls:NumericUpDown Grid.Column="1" StringFormat="0.00##" Interval="5" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.RotationX, UpdateSourceTrigger=Default}"/>

                                <Label Content="Blending" Grid.Column="2" Margin="10,0"  ToolTip="Amount of frames of interpolation to do between base camera and Rotation X."/>
                                <controls:NumericUpDown Grid.Column="3" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.RotationDurationX, UpdateSourceTrigger=Default, Converter={StaticResource uint16Converter}}"/>

                            </Grid>
                            <Grid Margin="3,3,0,0" Width="400" IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EnableTransformModifers}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Rotation Y"/>
                                <controls:NumericUpDown Grid.Column="1" StringFormat="0.00##" Interval="5" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.RotationY, UpdateSourceTrigger=Default}"/>

                                <Label Content="Blending" Grid.Column="2" Margin="10,0"  ToolTip="Amount of frames of interpolation to do between base camera and Rotation Y."/>
                                <controls:NumericUpDown Grid.Column="3" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.RotationDurationY, UpdateSourceTrigger=Default, Converter={StaticResource uint16Converter}}"/>

                            </Grid>
                            <Grid Margin="3,3,0,0" Width="400" IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EnableTransformModifers}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Rotation Z"/>
                                <controls:NumericUpDown Grid.Column="1" StringFormat="0.00##" Interval="1" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.RotationZ, UpdateSourceTrigger=Default}"/>

                                <Label Content="Blending" Grid.Column="2" Margin="10,0"  ToolTip="Amount of frames of interpolation to do between base camera and Rotation Z."/>
                                <controls:NumericUpDown Grid.Column="3" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.RotationDurationZ, UpdateSourceTrigger=Default, Converter={StaticResource uint16Converter}}"/>

                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <Grid Margin="3,3,0,0" Width="400" IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EnableTransformModifers}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Displacement XZ"/>
                                <controls:NumericUpDown Grid.Column="1" StringFormat="0.00##" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.DisplacementXZ, UpdateSourceTrigger=Default}"/>

                                <Label Content="Blending" Grid.Column="2" Margin="10,0"  ToolTip="Amount of frames of interpolation to do between base camera and Displacement XZ."/>
                                <controls:NumericUpDown Grid.Column="3" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.DisplacementDurationXZ, UpdateSourceTrigger=Default, Converter={StaticResource uint16Converter}}"/>

                            </Grid>
                            <Grid Margin="3,3,0,0" Width="400" IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EnableTransformModifers}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Displacement ZY"/>
                                <controls:NumericUpDown Grid.Column="1" StringFormat="0.00##" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.DisplacementZY, UpdateSourceTrigger=Default}"/>

                                <Label Content="Blending" Grid.Column="2" Margin="10,0"  ToolTip="Amount of frames of interpolation to do between base camera and Displacement ZY."/>
                                <controls:NumericUpDown Grid.Column="3" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.DisplacementDurationZY, UpdateSourceTrigger=Default, Converter={StaticResource uint16Converter}}" />

                            </Grid>
                            <Grid Margin="3,3,0,0" Width="400" IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.EnableTransformModifers}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Field Of View"/>
                                <controls:NumericUpDown Grid.Column="1" StringFormat="0.00##" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.FieldOfView, UpdateSourceTrigger=Default}"/>

                                <Label Content="Blending" Grid.Column="2" Margin="10,0"  ToolTip="Amount of frames of interpolation to do between base camera and Field Of View."/>
                                <controls:NumericUpDown Grid.Column="3" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType10View}}, Path=BacViewModel.FieldOfViewDuration, UpdateSourceTrigger=Default, Converter={StaticResource uint16Converter}}"/>

                            </Grid>
                        </StackPanel>



                    </WrapPanel>
                </Grid>


                </Expander>


        </StackPanel>
    </Grid>
</UserControl>
