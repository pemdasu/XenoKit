<UserControl x:Class="XenoKit.Views.BAC.BacType12View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:XenoKit.Views.BAC"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:bacDic="clr-namespace:Xv2CoreLib.ValuesDictionary;assembly=Xv2CoreLib" d:DataContext="{d:DesignInstance Type=local:BacType12View}"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="520">
    <Grid>

        <Expander Header="Tracking Axis" IsExpanded="True">
            <StackPanel HorizontalAlignment="Left">
                <StackPanel Margin="10, 5" Width="250">
                    <CheckBox Content="Pitch Tracking" ToolTip="Lets Tracking entries aim up and down as well as left and right." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType12View}}, Path=BacViewModel.Flag_PitchTracking, UpdateSourceTrigger=Default}"/>
                </StackPanel>
                <StackPanel Margin="10, 5" Width="250">
                    <CheckBox Content="Keep Airborne" ToolTip="Prevents the character from being treated as grounded or placed on the ground during this row." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType12View}}, Path=BacViewModel.Flag_Unk1, UpdateSourceTrigger=Default}"/>
                    <CheckBox Content="Disable Left Foot Planting" ToolTip="Stops the left foot from reaching down to the ground. Upward ground clearance remains active." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType12View}}, Path=BacViewModel.Flag_Unk3, UpdateSourceTrigger=Default}"/>
                    <CheckBox Content="Disable Right Foot Planting" ToolTip="Stops the right foot from reaching down to the ground. Upward ground clearance remains active." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType12View}}, Path=BacViewModel.Flag_Unk4, UpdateSourceTrigger=Default}"/>
                </StackPanel>
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
