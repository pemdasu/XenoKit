<UserControl x:Class="XenoKit.Views.BcsSkeletonDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XenoKit.Views"
             xmlns:lbUtils="clr-namespace:LB_Common.Utils;assembly=LB_Common"
             xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:bcs="clr-namespace:Xv2CoreLib.BCS;assembly=Xv2CoreLib"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:bcsDir="clr-namespace:Xv2CoreLib.ValuesDictionary;assembly=Xv2CoreLib"
             Dialog:DialogParticipation.Register="{Binding}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Name="UserControl">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0, 25">

            <StackPanel VerticalAlignment="Center" Margin="2.5">
                <Button Command="{Binding ElementName=UserControl, Path=AddBoneCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Style="{DynamicResource MahApps.Styles.Button.Circle}" Height="30">
                    <iconPacks:PackIconMaterialLight Kind="Plus"/>
                </Button>
                <TextBlock Text="New" HorizontalAlignment="Center" FontSize="10"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="2.5">
                <Button Command="{Binding ElementName=UserControl, Path=RemoveBoneCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Style="{DynamicResource MahApps.Styles.Button.Circle}" Height="30">
                    <iconPacks:PackIconMaterialLight Kind="Delete"/>
                </Button>
                <TextBlock Text="Remove" HorizontalAlignment="Center" FontSize="10"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="skeletonDataGrid" Grid.Column="1" Tag="{Binding DataContext, ElementName=UserControl}" ItemsSource="{Binding ElementName=UserControl, Path=SkeletonData.Bones.Binding}" SelectedItem="{Binding ElementName=UserControl, Path=SelectedBone}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Bone" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding BoneName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{x:Static bcsDir:BCS.CommonSkeletonDataBones}" SelectedItem="{Binding ElementName=UserControl, Path=SkeletonViewModel.BoneName, UpdateSourceTrigger=Default}" controls:TextBoxHelper.Watermark="{Binding ElementName=UserControl, Path=SkeletonViewModel.BoneName, Mode=OneWay}" IsEditable="False"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add" Command="{Binding AddBoneCommand}"/>
                    <MenuItem Header="Duplicate" Command="{Binding DuplicateBoneCommand}"/>
                    <MenuItem Header="Delete" Command="{Binding RemoveBoneCommand}"/>
                    <Separator/>
                    <MenuItem Header="Copy" Command="{Binding CopyBoneCommand}"/>
                    <MenuItem Header="Paste" Command="{Binding PasteBoneCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding RemoveBoneCommand}"/>
                <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyBoneCommand}"/>
                <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteBoneCommand}"/>
                <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateBoneCommand}"/>
            </DataGrid.InputBindings>
        </DataGrid>

        <ScrollViewer Grid.Column="2" Margin="8" VerticalScrollBarVisibility="Auto" Visibility="{Binding ElementName=UserControl, Path=EditorVisibility}">
            <StackPanel>
                <TextBlock Text="Collider" FontWeight="SemiBold" Margin="0,8"/>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Label Content="Bone" ToolTip="The bone that carries this collider during animation."/>
                    <ComboBox Grid.Column="1" ItemsSource="{x:Static bcsDir:BCS.CommonSkeletonDataBones}" SelectedItem="{Binding ElementName=UserControl, Path=SkeletonViewModel.BoneName}" controls:TextBoxHelper.Watermark="{Binding ElementName=UserControl, Path=SkeletonViewModel.BoneName, Mode=OneWay}" IsEditable="False" ToolTip="The collider follows this bone during animation."/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Label Content="Shape" ToolTip="The solid shape that pushes SCD bodies away from this bone."/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ElementName=UserControl, Path=SkeletonViewModel.Shapes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding ElementName=UserControl, Path=SkeletonViewModel.Shape}" IsEditable="False" controls:TextBoxHelper.Watermark="{Binding ElementName=UserControl, Path=SkeletonViewModel.ShapeLabel}" ToolTip="Box uses all three size values. Sphere uses X. Cylinder and capsule use X and Y."/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Label Content="Collision filter" ToolTip="Controls which SCD bodies can collide with this shape."/>
                    <controls:NumericUpDown Grid.Column="1" Value="{Binding ElementName=UserControl, Path=SkeletonViewModel.I_00}" Minimum="-2147483648" Maximum="2147483647" ToolTip="Keep the existing filter unless you know which collision group is needed."/>
                </Grid>
                <TextBlock Text="Position" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <controls:NumericUpDown Grid.Column="0" Margin="2" Value="{Binding ElementName=UserControl, Path=SkeletonViewModel.F_12}" StringFormat="0.######" Interval="0.01" ToolTip="X offset from the selected bone." AutomationProperties.Name="Position X"/>
                    <controls:NumericUpDown Grid.Column="1" Margin="2" Value="{Binding ElementName=UserControl, Path=SkeletonViewModel.F_16}" StringFormat="0.######" Interval="0.01" ToolTip="Y offset from the selected bone." AutomationProperties.Name="Position Y"/>
                    <controls:NumericUpDown Grid.Column="2" Margin="2" Value="{Binding ElementName=UserControl, Path=SkeletonViewModel.F_20}" StringFormat="0.######" Interval="0.01" ToolTip="Z offset from the selected bone." AutomationProperties.Name="Position Z"/>
                </Grid>
                <TextBlock Text="Rotation (radians)" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <controls:NumericUpDown Grid.Column="0" Margin="2" Value="{Binding ElementName=UserControl, Path=SkeletonViewModel.F_24}" StringFormat="0.######" Interval="0.01" ToolTip="Rotation around the bone's X axis, in radians." AutomationProperties.Name="Rotation (radians) X"/>
                    <controls:NumericUpDown Grid.Column="1" Margin="2" Value="{Binding ElementName=UserControl, Path=SkeletonViewModel.F_28}" StringFormat="0.######" Interval="0.01" ToolTip="Rotation around the bone's Y axis, in radians." AutomationProperties.Name="Rotation (radians) Y"/>
                    <controls:NumericUpDown Grid.Column="2" Margin="2" Value="{Binding ElementName=UserControl, Path=SkeletonViewModel.F_32}" StringFormat="0.######" Interval="0.01" ToolTip="Rotation around the bone's Z axis, in radians." AutomationProperties.Name="Rotation (radians) Z"/>
                </Grid>
                <TextBlock Text="Size" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <controls:NumericUpDown Grid.Column="0" Margin="2" Value="{Binding ElementName=UserControl, Path=SkeletonViewModel.F_36}" StringFormat="0.######" Interval="0.01" ToolTip="Box width. Sphere, cylinder or capsule radius." AutomationProperties.Name="Size X"/>
                    <controls:NumericUpDown Grid.Column="1" Margin="2" Value="{Binding ElementName=UserControl, Path=SkeletonViewModel.F_40}" StringFormat="0.######" Interval="0.01" ToolTip="Box height. Cylinder height or capsule center length." AutomationProperties.Name="Size Y"/>
                    <controls:NumericUpDown Grid.Column="2" Margin="2" Value="{Binding ElementName=UserControl, Path=SkeletonViewModel.F_44}" StringFormat="0.######" Interval="0.01" ToolTip="Box depth. Not used by the other shapes." AutomationProperties.Name="Size Z"/>
                </Grid>
                <TextBlock Text="Box: width, height, depth. Sphere: radius. Cylinder and capsule: radius, length." TextWrapping="Wrap" Margin="0,8"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>