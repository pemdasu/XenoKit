<UserControl x:Class="XenoKit.Views.BAC.BacType1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:XenoKit.Views.BAC"
             xmlns:bacDic="clr-namespace:Xv2CoreLib.ValuesDictionary;assembly=Xv2CoreLib" d:DataContext="{d:DesignInstance Type=local:BacType0View}"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="520">
    <Grid>
        <StackPanel>
            <Expander Margin="0, 2, 0, 0" Header="Hitbox" IsExpanded="True">
                <Grid>
                    <WrapPanel>
                        <Grid Margin="3,5,0,0" Width="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="BDM File"/>
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static bacDic:BAC.BdmType}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.BdmType}"/>
                        </Grid>
                        <Grid Margin="3,5,0,0" Width="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="BDM ID"/>
                            <controls:NumericUpDown Grid.Column="1" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.BdmEntryID, UpdateSourceTrigger=Default}" Maximum="65535" Minimum="0"/>
                        </Grid>
                        <Grid Margin="3,5,0,0" Width="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Damage" ToolTip="Damage taken by the target (when not guarding), in addition to damage dealt by the BDM entry."/>
                            <controls:NumericUpDown Grid.Column="1" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.Damage, UpdateSourceTrigger=Default}" Maximum="65535" Minimum="0"/>
                        </Grid>
                        <Grid Margin="3,5,0,0" Width="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Damage (blocked)" ToolTip="Damage taken by the target when blocking, in addition to damage dealt by the BDM entry."/>
                            <controls:NumericUpDown Grid.Column="1" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.DamageWhenBlocked, UpdateSourceTrigger=Default}" Maximum="65535" Minimum="0"/>
                        </Grid>
                        <Grid Margin="3,5,0,0" Width="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Stamina (blocked)" ToolTip="Stamina consumed by the target after blocking this hitbox."/>
                            <controls:NumericUpDown Grid.Column="1" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.StaminaBlockedConsume, UpdateSourceTrigger=Default}" Maximum="65535" Minimum="0"/>
                        </Grid>


                    </WrapPanel>

                </Grid>
            </Expander>
            <Expander Header="Settings" IsExpanded="True">
                <StackPanel>
                    <WrapPanel>
                        <Grid Margin="3,5,0,0" Width="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Impact Type"/>
                            <ComboBox Grid.Column="1" IsEditable="False" ToolTip="Chooses repeat contact or projectile cancellation. Projectile responses depend on the projectile's priority. Same Actor Only limits contact to the user." ItemsSource="{x:Static bacDic:BAC.BdmImpactType}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.ImpactType}" controls:TextBoxHelper.Watermark="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.ImpactTypeLabel}"/>
                        </Grid>
                        <Grid Margin="3,5,0,0" Width="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Damage Type"/>
                            <ComboBox Grid.Column="1" IsEditable="False" ToolTip="Health damages the target, Restore Health heals it, and Ki drains its Ki. Block and Reflect Projectiles act only on eligible projectiles." ItemsSource="{x:Static bacDic:BAC.BdmDamageType}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.DamageType}" controls:TextBoxHelper.Watermark="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.DamageTypeLabel}"/>
                        </Grid>
                        <Grid Margin="3,5,0,0" Width="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Hitbox Mode"/>
                            <ComboBox Grid.Column="1" IsEditable="False" ToolTip="Target uses the linked target's bones. Other modes use your bones. Target Hit Actor changes your target to the actor hit. Absorption gains Ki from the projectile's last-hit BDM." ItemsSource="{x:Static bacDic:BAC.BdmSpawnSource}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.HitboxSpawnSource}" controls:TextBoxHelper.Watermark="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.HitboxSpawnSourceLabel}"/>
                        </Grid>
                        <Grid Margin="3,5,0,0" Width="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Bone"/>
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static bacDic:BAC.BoneNames}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.BoneLink}"/>
                        </Grid>
                    </WrapPanel>

                </StackPanel>
            </Expander>
            <Expander Header="Bounding Shape" IsExpanded="True">
                <StackPanel Width="500" HorizontalAlignment="Left">
                    <Grid Margin="3,5,0,0" Width="250" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Type"/>
                        <ComboBox Grid.Column="1" IsEditable="False" ItemsSource="{x:Static bacDic:BAC.BoundingBoxType}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.BoundingBoxType}" controls:TextBoxHelper.Watermark="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.BoundingBoxTypeLabel}" ToolTip="Fixed Size ignores the character's body size."/>
                    </Grid>
                    <Grid Margin="3,5,0,0" Width="250" HorizontalAlignment="Left" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.UsesRadius, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Radius"/>
                        <controls:NumericUpDown Grid.Column="1" StringFormat="0.00#####" Interval="0.05" Minimum="0" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.Size}"/>
                    </Grid>
                    <Grid Margin="3,5,0,0" Width="500">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Position" ToolTip="Offset from the selected bone."/>
                        <Label Grid.Column="1" Content="X"/>
                        <controls:NumericUpDown Grid.Column="2" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.PositionX}"/>
                        <Label Grid.Column="3" Content="Y"/>
                        <controls:NumericUpDown Grid.Column="4" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.PositionY}"/>
                        <Label Grid.Column="5" Content="Z"/>
                        <controls:NumericUpDown Grid.Column="6" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.PositionZ}"/>
                    </Grid>
                    <Grid Margin="3,5,0,0" Width="500" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.IsCapsule, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="End A" ToolTip="First endpoint relative to the hitbox position."/>
                        <Label Grid.Column="1" Content="X"/>
                        <controls:NumericUpDown Grid.Column="2" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.MinX}"/>
                        <Label Grid.Column="3" Content="Y"/>
                        <controls:NumericUpDown Grid.Column="4" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.MinY}"/>
                        <Label Grid.Column="5" Content="Z"/>
                        <controls:NumericUpDown Grid.Column="6" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.MinZ}"/>
                    </Grid>
                    <Grid Margin="3,5,0,0" Width="500" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.IsCapsule, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="End B" ToolTip="Second endpoint relative to the hitbox position."/>
                        <Label Grid.Column="1" Content="X"/>
                        <controls:NumericUpDown Grid.Column="2" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.MaxX}"/>
                        <Label Grid.Column="3" Content="Y"/>
                        <controls:NumericUpDown Grid.Column="4" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.MaxY}"/>
                        <Label Grid.Column="5" Content="Z"/>
                        <controls:NumericUpDown Grid.Column="6" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.MaxZ}"/>
                    </Grid>
                    <Grid Margin="3,5,0,0" Width="500" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.IsBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Half Size" ToolTip="Distance from the box center to each side."/>
                        <Label Grid.Column="1" Content="X"/>
                        <controls:NumericUpDown Grid.Column="2" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.Size}"/>
                        <Label Grid.Column="3" Content="Y"/>
                        <controls:NumericUpDown Grid.Column="4" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.MinX}"/>
                        <Label Grid.Column="5" Content="Z"/>
                        <controls:NumericUpDown Grid.Column="6" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.MinY}"/>
                    </Grid>
                    <Grid Margin="3,5,0,0" Width="500" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.IsBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Rotation" ToolTip="Angles in radians, applied in X, Y, then Z order."/>
                        <Label Grid.Column="1" Content="X"/>
                        <controls:NumericUpDown Grid.Column="2" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.MinZ}"/>
                        <Label Grid.Column="3" Content="Y"/>
                        <controls:NumericUpDown Grid.Column="4" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.MaxX}"/>
                        <Label Grid.Column="5" Content="Z"/>
                        <controls:NumericUpDown Grid.Column="6" StringFormat="0.00#####" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.MaxY}"/>
                    </Grid>
                </StackPanel>
            </Expander>
            <Expander Header="Unknown" IsExpanded="False">
                <StackPanel HorizontalAlignment="Left">
                    <Grid Margin="3,5,0,0" Width="250" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="_I_20"/>
                        <controls:NumericUpDown Grid.Column="1" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.I_20, UpdateSourceTrigger=Default}" Maximum="65535" Minimum="0"/>
                    </Grid>
                    <StackPanel Margin="10, 2" Width="500" MaxWidth="500" HorizontalAlignment="Left">
                        <Label Content="Flags" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="10" FontWeight="SemiBold"/>
                        <Separator/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="20, 5" Width="200">
                                <CheckBox Content="Unk1"  IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.HitboxFlagA_Unk1, UpdateSourceTrigger=Default}"/>
                                <CheckBox Content="Unk2" IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.HitboxFlagA_Unk2, UpdateSourceTrigger=Default}" />

                            </StackPanel>
                            <StackPanel Margin="20, 5" Width="200">
                                <CheckBox Content="Unk3" IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.HitboxFlagA_Unk3, UpdateSourceTrigger=Default}" />
                                <CheckBox Content="Unk4" IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType1View}}, Path=BacViewModel.HitboxFlagA_Unk4, UpdateSourceTrigger=Default}"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
