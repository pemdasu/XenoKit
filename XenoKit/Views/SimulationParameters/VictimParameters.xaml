<UserControl x:Class="XenoKit.Views.SimulationParameters.VictimParameters"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600" Name="UserControl">
    <Grid>
        <ScrollViewer Margin="3">
            <StackPanel>
                <Grid Margin="3,5,0,0" Width="250" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Victim"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding ElementName=UserControl, Path=VictimEnabled}"/>
                </Grid>
                <Grid Margin="3,5,0,0" Width="250" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Auto recover" ToolTip="Return the victim to idle after damage or when the recovery limit is reached."/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding ElementName=UserControl, Path=VictimAutoRecover}"/>
                </Grid>
                <Grid Margin="3,5,0,0" Width="250" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Recovery limit" ToolTip="Maximum frames before a looping knockback returns to idle."/>
                    <controls:NumericUpDown Grid.Column="1" Minimum="1" Maximum="3600" Interval="1" StringFormat="0" Value="{Binding ElementName=UserControl, Path=VictimRecoveryFrames, Mode=TwoWay}"/>
                </Grid>
                <Grid Margin="3,5,0,0" Width="250" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Invulnerable" ToolTip="Projectiles and melee attacks pass through the victim."/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding ElementName=UserControl, Path=VictimInvulnerable}"/>
                </Grid>
                <Grid Margin="3,5,0,0" Width="500" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Position"/>
                    <Label Grid.Column="1" Content="X"/>
                    <controls:NumericUpDown Grid.Column="2" StringFormat="0.00" Interval="0.1" Value="{Binding ElementName=UserControl, Path=PositionX, Mode=TwoWay}"/>
                    <Label Grid.Column="3" Content="Y"/>
                    <controls:NumericUpDown Grid.Column="4" StringFormat="0.00" Interval="0.1" Value="{Binding ElementName=UserControl, Path=PositionY, Mode=TwoWay}"/>
                    <Label Grid.Column="5" Content="Z"/>
                    <controls:NumericUpDown Grid.Column="6" StringFormat="0.00" Interval="0.1" Value="{Binding ElementName=UserControl, Path=PositionZ, Mode=TwoWay}"/>
                </Grid>
                <Grid Margin="3,5,0,0" Width="500" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Rotation"/>
                    <Label Grid.Column="1" Content="X"/>
                    <controls:NumericUpDown Grid.Column="2" StringFormat="0.00" Interval="1" Value="{Binding ElementName=UserControl, Path=RotationX, Mode=TwoWay}"/>
                    <Label Grid.Column="3" Content="Y"/>
                    <controls:NumericUpDown Grid.Column="4" StringFormat="0.00" Interval="1" Value="{Binding ElementName=UserControl, Path=RotationY, Mode=TwoWay}"/>
                    <Label Grid.Column="5" Content="Z"/>
                    <controls:NumericUpDown Grid.Column="6" StringFormat="0.00" Interval="1" Value="{Binding ElementName=UserControl, Path=RotationZ, Mode=TwoWay}"/>
                </Grid>
                <Grid Margin="3,5,0,0" Width="250" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Hit State" ToolTip="Choose which BDM subentry the next hit uses. Automatic uses the victim's current damage state."/>
                    <ComboBox Grid.Column="1" x:Name="victimStateComboBox" SelectionChanged="victimStateComboBox_SelectionChanged">
                        <ComboBoxItem Content="Automatic"/>
                        <ComboBoxItem Content="Guarding"/>
                        <ComboBoxItem Content="Stumble"/>
                        <ComboBoxItem Content="Knockback"/>
                        <ComboBoxItem Content="Floating Knockback"/>
                        <ComboBoxItem Content="Ground Impact"/>
                        <ComboBoxItem Content="Knocked Down"/>
                        <ComboBoxItem Content="Back Hit"/>
                    </ComboBox>
                </Grid>
                <Button Margin="128,8,0,0" Width="125" HorizontalAlignment="Left" Content="Move / Rotate" IsEnabled="{Binding ElementName=UserControl, Path=CanMoveVictim}" Click="MoveVictim_Click" ToolTip="Move or rotate the victim in the viewport to test tracking and spread."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
