<UserControl x:Class="XenoKit.Views.BAC.BacType17View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:XenoKit.Views.BAC"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:bacDic="clr-namespace:Xv2CoreLib.ValuesDictionary;assembly=Xv2CoreLib" d:DataContext="{d:DesignInstance Type=local:BacType17View}"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="520">
    <Grid>

        <Expander Header="Throw Handler" IsExpanded="True">
            <StackPanel>
                <Grid Margin="3,5,0,0" Width="250" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="BAC Entry Jump"/>
                    <controls:NumericUpDown Grid.Column="1" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.BacEntryID, UpdateSourceTrigger=Default}" Maximum="65535" Minimum="0"/>
                </Grid>
                <Grid Margin="3,5,0,0" Width="500" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="105"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Displacement" ToolTip="The victim will be displaced by this relative to the throw source."/>
                    <Label Grid.Column="1" Content="X"/>
                    <controls:NumericUpDown Grid.Column="2" StringFormat="0.00" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.DisplacementX, UpdateSourceTrigger=Default}"/>

                    <Label Grid.Column="3" Content="Y"/>
                    <controls:NumericUpDown Grid.Column="4" StringFormat="0.00" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.DisplacementY, UpdateSourceTrigger=Default}"/>

                    <Label Grid.Column="5" Content="Z"/>
                    <controls:NumericUpDown Grid.Column="6" StringFormat="0.00" Interval="0.05" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.DisplacementZ, UpdateSourceTrigger=Default}"/>

                </Grid>
                <StackPanel Width="510" HorizontalAlignment="Left">
                    <Label Content="Bone Connections" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="10" FontWeight="SemiBold"/>
                    <Separator/>

                    <StackPanel Orientation="Horizontal">
                        <Grid Margin="3,5,0,0" Width="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="User Bone"/>
                            <ComboBox Grid.Column="1" IsEditable="False" ItemsSource="{x:Static bacDic:BAC.BoneNames}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.UserBone}"/>
                        </Grid>
                        <Grid Margin="3,5,0,0" Width="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Target Bone"/>
                            <ComboBox Grid.Column="1" IsEditable="False" ItemsSource="{x:Static bacDic:BAC.BoneNames}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.VictimBone}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                <Grid Margin="3,5,0,0" Width="250" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Follow State" ToolTip="Used when BAC Entry Jump is 65535. Choose stance, a landing bounce, or lying on the ground."/>
                    <ComboBox Grid.Column="1" AutomationProperties.Name="Follow State" IsEditable="False"
                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.FollowStates}"
                              DisplayMemberPath="Value" SelectedValuePath="Key"
                              SelectedValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.FollowState}"
                              controls:TextBoxHelper.Watermark="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.FollowStateLabel}"
                              ToolTip="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.FollowStateLabel}"/>
                </Grid>
                <Label Content="Actor binding" HorizontalContentAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                <Separator/>
                <WrapPanel Margin="5">
                    <CheckBox Width="250" Margin="5,2" Content="Fill Throw Slot 0" ToolTip="Fills the first throw slot. Most throws use this slot." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_UseSlot0, UpdateSourceTrigger=Default}" />
                    <CheckBox Width="250" Margin="5,2" Content="Fill Throw Slot 1" ToolTip="Fills the second throw slot." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_UseSlot1, UpdateSourceTrigger=Default}" />
                    <CheckBox Width="250" Margin="5,2" Content="Pick Mover by Size (No Blend)" ToolTip="Compares the size of both actors to decide which one moves. The move does not blend." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag2_CompareSizeNoBlend, UpdateSourceTrigger=Default}"/>
                    <CheckBox Width="250" Margin="5,2" Content="Pick Mover by Size (Blend)" ToolTip="Compares the size of both actors to decide which one moves. The move blends." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag2_CompareSizeBlend, UpdateSourceTrigger=Default}"/>
                    <CheckBox Width="250" Margin="5,2" Content="Thrower Moves" ToolTip="By default the victim moves to the thrower. With this on the thrower moves to the victim." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag2_ThrowerMoves, UpdateSourceTrigger=Default}"/>
                    <CheckBox Width="250" Margin="5,2" Content="Snap to Bind Point" ToolTip="The moved actor snaps to the bind point instead of blending to it." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_SnapToBind, UpdateSourceTrigger=Default}" />
                    <CheckBox Width="250" Margin="5,2" Content="Displacement Uses Body Rotation" ToolTip="Rotates the displacement with the body of the anchor actor instead of with its bone." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag2_UseBodyRotation, UpdateSourceTrigger=Default}"/>
                    <CheckBox Width="250" Margin="5,2" Content="Keep Pitch" ToolTip="Keeps the pitch of the bound actor. Without it the pitch resets to 0." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_KeepPitch, UpdateSourceTrigger=Default}" />
                    <CheckBox Width="250" Margin="5,2" Content="Keep Out of Geometry" ToolTip="After the bind, a ground and wall check keeps the moved actor out of the stage." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag2_KeepOutOfGeometry, UpdateSourceTrigger=Default}"/>
                    <CheckBox Width="250" Margin="5,2" Content="Enable Body Collision" ToolTip="Enables body collision for both actors during the throw." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_Unk12, UpdateSourceTrigger=Default}" />
                </WrapPanel>
                <Label Content="Entry jump" HorizontalContentAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                <Separator/>
                <WrapPanel Margin="5">
                    <CheckBox Width="250" Margin="5,2" Content="Update Animation On Jump" ToolTip="Updates the new animation immediately when BAC Entry Jump runs." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_UpdateAnimationOnJump, UpdateSourceTrigger=Default}"/>
                    <CheckBox Width="250" Margin="5,2" Content="Jump When Any Actor Lands" ToolTip="Jumps to the BAC Entry Jump when the thrower or the victim lands." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_JumpWhenAnyLands, UpdateSourceTrigger=Default}"/>
                    <CheckBox Width="250" Margin="5,2" Content="Jump When This Actor Lands" ToolTip="Jumps to the BAC Entry Jump when this actor lands." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_JumpWhenSelfLands, UpdateSourceTrigger=Default}" />
                    <CheckBox Width="250" Margin="5,2" Content="Jump When Animation Ends" ToolTip="Jumps to the BAC Entry Jump when the animation ends. This is also the default when no jump condition is set." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_JumpWhenAnimationEnds, UpdateSourceTrigger=Default}" />
                    <CheckBox Width="250" Margin="5,2" Content="Turn Around On Jump" ToolTip="Turns the actor 180 degrees when the BAC Entry Jump happens." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_TurnAroundOnJump, UpdateSourceTrigger=Default}" />
                    <CheckBox Width="250" Margin="5,2" Content="Face Away On Jump" ToolTip="Makes the actor face away from the target when the BAC Entry Jump happens." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_FaceAwayOnJump, UpdateSourceTrigger=Default}" />
                    <CheckBox Width="250" Margin="5,2" Content="Face Toward On Jump" ToolTip="Faces the current target when BAC Entry Jump runs. Face Away On Jump takes priority when both are on." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_FaceTowardOnJump, UpdateSourceTrigger=Default}"/>
                    <CheckBox Width="250" Margin="5,2" Content="Aim Release at Partner's Target" ToolTip="Aims release movement at the partner's target when it is ahead. Otherwise clears release movement." IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_Unk16, UpdateSourceTrigger=Default}"/>
                </WrapPanel>
                <Label Content="Unknown" HorizontalContentAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                <Separator/>
                <WrapPanel Margin="5">
                    <CheckBox Width="250" Margin="5,2" Content="Unk7" IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_Unk7, UpdateSourceTrigger=Default}" />
                    <CheckBox Width="250" Margin="5,2" Content="Unk14" IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_Unk14, UpdateSourceTrigger=Default}"/>
                    <CheckBox Width="250" Margin="5,2" Content="Unk15" IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag_Unk15, UpdateSourceTrigger=Default}" />
                    <CheckBox Width="250" Margin="5,2" Content="Unk6" IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BacType17View}}, Path=BacViewModel.Flag2_Unk6, UpdateSourceTrigger=Default}"/>
                </WrapPanel>
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
